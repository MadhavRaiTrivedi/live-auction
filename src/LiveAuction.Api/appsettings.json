{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Auctions": "",
    "Redis": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "live-auction",
    "Audience": "live-auction-api",
    "SigningKey": "",
    "TokenLifetime": "08:00:00",
    "EnableDevTokenEndpoint": false
  },
  "Auctions": {
    "MaxDuration": "30.00:00:00"
  },
  "Bidding": {
    "IncrementTiers": [
      { "UpToInPaise": 100000, "IncrementInPaise": 1000 },
      { "UpToInPaise": 1000000, "IncrementInPaise": 5000 },
      { "UpToInPaise": null, "IncrementInPaise": 10000 }
    ],
    "SoftCloseWindow": "00:00:30",
    "SoftCloseExtension": "00:00:30",
    "MaxConcurrencyAttempts": 5
  },
  "RateLimiting": {
    "Bids": {
      "TokenLimit": 5,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriod": "00:00:01"
    }
  },
  "Lifecycle": {
    "IsEnabled": true,
    "Interval": "00:00:01",
    "BatchSize": 100
  }
}
